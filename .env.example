# Server-only credentials. Missing/blank key keeps deterministic generation and analysis working.
OPENAI_API_KEY=
# OpenAI Responses API model supporting structured outputs.
OPENAI_MODEL=gpt-4o-mini
# auto enables AI when a key is present; local disables all model calls.
FARSIGHT_AI_MODE=auto
# Timeout per request in milliseconds (1–60000, default 18000).
# Strategy makes at most two calls: initial + one malformed/invalid-output repair.
# Outages, HTTP errors, refusals and timeouts fall back immediately.
FARSIGHT_LLM_TIMEOUT_MS=18000

# Optional Future Research search; absent/failed search returns explicit demo factors.
TAVILY_API_KEY=

# Research: auto uses Tavily when configured, otherwise OpenAI hosted web search.
# demo disables live research; FARSIGHT_AI_MODE=local also disables it.
FARSIGHT_RESEARCH_PROVIDER=auto
# Independent from the strategy/analysis model; must support Responses web_search.
FARSIGHT_RESEARCH_MODEL=gpt-4.1-mini
# OpenAI search: 30s per attempt, one transient retry, 65s total research deadline.
